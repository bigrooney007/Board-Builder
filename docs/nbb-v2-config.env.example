# Use an isolated test database. Never point a V2 test run at customer records.
# The original application stays unchanged and V2 stays disabled by default.
NBB_V2_ENABLED=false
NBB_V2_ORIGIN=http://localhost:3000

# Set these to independently generated random values, not these comments.
# Preview key: at least 16 characters. Session secret: at least 32 characters.
NBB_V2_PREVIEW_KEY=
NBB_V2_SESSION_SECRET=

# Test-only until the owner explicitly authorizes release.
NBB_V2_PAYMENTS_TEST_ONLY=true
NBB_V2_STRIPE_SECRET_KEY=
NBB_V2_EMAIL_TEST_MODE=true
NBB_V2_TEST_EMAILS=
NBB_V2_NETWORK_LIVE_ENABLED=false
NBB_V2_NETWORK_TEST_EMAILS=

# Existing provider credentials/senders remain required for actual integration
# tests. Do not commit them. Synthetic acceptance tests need none of these.
# RESEND_API_KEY, NONPROFIT_SENDER, BOARD_APPLICANT_SENDER,
# RESEND_BOARD_OPPORTUNITIES_TOPIC_ID, ANTHROPIC_API_KEY / EMERGENT_LLM_KEY.

# Default previews remain noindex/nofollow and absent from original navigation.
# Enable NBB_V2_ENABLED only in an isolated preview after source verification.
