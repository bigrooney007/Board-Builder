# Optional V2 overrides. Normal deployment reuses the application's database,
# PUBLIC_ORIGIN, JWT_SECRET, Stripe, Resend and AI configuration. Never use
# customer records for synthetic tests; use tests/v2_local_app.py instead.
# The /v2 pages are enabled by default. Original routes remain unchanged.
NBB_V2_ENABLED=true
NBB_V2_ORIGIN=https://nonprofitboardbuilder.com

# Leave the preview key blank for normal access without a preview password.
# To deliberately restrict an instance, configure a key of at least 16 characters.
# Session secret reuses JWT_SECRET unless overridden with a 32-character secret.
NBB_V2_PREVIEW_KEY=
NBB_V2_SESSION_SECRET=

# Existing Stripe key determines real or test checkout. Tests explicitly enforce
# test-only payments and allowlisted email recipients in the fixture process.
NBB_V2_PAYMENTS_TEST_ONLY=false
NBB_V2_STRIPE_SECRET_KEY=
NBB_V2_EMAIL_TEST_MODE=false
NBB_V2_TEST_EMAILS=
NBB_V2_NETWORK_LIVE_ENABLED=false
NBB_V2_NETWORK_TEST_EMAILS=

# Existing provider credentials/senders remain required for actual integration
# tests. Do not commit them. Synthetic acceptance tests need none of these.
# RESEND_API_KEY, NONPROFIT_SENDER, BOARD_APPLICANT_SENDER,
# RESEND_BOARD_OPPORTUNITIES_TOPIC_ID, ANTHROPIC_API_KEY / EMERGENT_LLM_KEY.

# V2 remains noindex/nofollow and absent from original navigation.
# Applicant network broadcasts still require explicit configuration and confirmed
# campaign launch; ordinary deployment does not send an announcement.
